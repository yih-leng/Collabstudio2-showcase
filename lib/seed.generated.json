    {
      "id": "47442940-6510-51fc-a23f-2c3c8ba02c09",
      "project_id": "d772ee24-5b88-5877-aa2c-7d9f7b25c0b1",
      "label": "Two directions",
      "body": "Say \"More\" Boldly: big type with lifestyle photography. The Infinite \"More\": a flowing wave headline with warm everyday moments.",
      "sort_order": 1
    },
    {
      "id": "e0c74bcb-5b4b-56cc-a872-fe557c957ccd",
      "project_id": "5e29e069-00ae-527b-a8b6-64bb6db68e46",
      "label": "Big idea",
      "body": "\"When Life Gives You Twists\": vertical dramas inspired by Chinese and Korean TikTok dramas. Melodramatic, humorous and fast-paced.",
