  "overview_blocks": [
    {
      "id": "ace36152-53e4-5e1d-a6e4-e7da55f761af",
      "project_id": "db27acde-e638-5f6e-a4e1-b36501661b91",
      "label": "Big idea",
      "body": "\"Skech Your Vibe\": creative freedom found anywhere, from city alleys to the beach to street music. Tagline: \"Skech in style, feel the vibe.\"",
      "sort_order": 0
    },
    {
      "id": "f705cefe-0cb7-557f-ad0a-f1e87be5a06d",
      "project_id": "db27acde-e638-5f6e-a4e1-b36501661b91",
      "label": "Story",
      "body": "One character's journey in four parts: alley, beach, busking band and night city. His T-shirt artwork turns into 2D animation at each stop.",
      "sort_order": 1
    },
    {
      "id": "de84ce4b-9748-51a9-a443-ff61ad3f83aa",
      "project_id": "db27acde-e638-5f6e-a4e1-b36501661b91",
      "label": "Look and cast",
      "body": "Stylised cinematic realism, with a live-action look mixed with animated 2D Cloakwork artwork. 8 characters: 6 male, 2 female.",
      "sort_order": 2
    },
    {
      "id": "c04043c5-3ff6-5ced-adb6-78f81e4f2ca5",
      "project_id": "db27acde-e638-5f6e-a4e1-b36501661b91",
      "label": "Timeline",
      "body": "Storyboard 10 Jun to final approval 23 Jun 2026; client review rounds to 10 Jul 2026.",
      "sort_order": 3
    },
    {
      "id": "0eb696ce-4c10-5ca3-a408-85df8a583701",
      "project_id": "eae963eb-14a8-5e6e-a711-cc63ec75c51c",
      "label": "Audience",
      "body": "Young generation: rural mass on the East Coast, and urban households in the Klang Valley.",
      "sort_order": 0
    },
    {
      "id": "05ae3225-3949-5e00-a6d7-3efbbcc27d28",
      "project_id": "eae963eb-14a8-5e6e-a711-cc63ec75c51c",
      "label": "Big idea",
      "body": "Superhero-film energy with human-like characters in forward-futuristic fashion, training their abilities. Pillars: Fashion, Action, Attitude.",
      "sort_order": 1
    },
    {
      "id": "8fe412d8-12e3-539d-ab96-e89f70b7094c",
      "project_id": "eae963eb-14a8-5e6e-a711-cc63ec75c51c",
      "label": "Look and cast",
      "body": "Stylised reality in a bright orange-sky metropolis, never dark or dystopian. 3 AI characters: The Charger, The Breaker, The Mover.",
      "sort_order": 2
    },
    {
      "id": "be676130-96ff-5269-ad34-3d117202f33d",
      "project_id": "eae963eb-14a8-5e6e-a711-cc63ec75c51c",
      "label": "Timeline",
      "body": "Brief 25 Mar 2026, final approval 10 Apr, live 13 Apr; language and format submissions to 13 May 2026.",
      "sort_order": 3
    },
    {
      "id": "a43b31af-4c84-5559-af16-42743f041327",
      "project_id": "3838ffd4-2370-528e-a0a0-bb85caa7a0e5",
      "label": "Big idea",
      "body": "\"Because family comes first, we made priority shareable.\" UMobile ULTRA sits alongside premium choices like flying business class.",
      "sort_order": 0
    },
    {
      "id": "4d1c37f1-aef3-58ac-a4d7-275ff40794dc",
      "project_id": "3838ffd4-2370-528e-a0a0-bb85caa7a0e5",
      "label": "Cast",
      "body": "A mother in her late 20s and her 2-year-old son, with a pan-Asian look for Malay and Chinese audiences.",
      "sort_order": 1
    },
    {
      "id": "f1920ae9-6b61-56b3-adc2-7f8e41fe7670",
      "project_id": "3838ffd4-2370-528e-a0a0-bb85caa7a0e5",
      "label": "Versions",
      "body": "West Coast: the approved key visual. East Coast: a modern tudung or hijab look for the T20 audience.",
      "sort_order": 2
    },
    {
      "id": "eca38df9-27fd-51db-a152-1cfc6ffcb10a",
      "project_id": "3838ffd4-2370-528e-a0a0-bb85caa7a0e5",
      "label": "Timeline",
      "body": "Hi-res key visual due 12 Mar 2026, launch 7 Apr 2026. One year in Malaysia across BTL, digital, web, social and on-ground.",
      "sort_order": 3
    },
    {
      "id": "6686ff1d-c871-5bf3-a4cb-a92b1935997b",
      "project_id": "d772ee24-5b88-5877-aa2c-7d9f7b25c0b1",
      "label": "Big idea",
      "body": "\"More Value in Every Way\" across more rewards (QR Pay), more flexibility (SPayLater) and more potential returns (Money+).",
