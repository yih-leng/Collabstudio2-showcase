# Copy to .env.local (for your computer) and add the same two values in Vercel
# (Project → Settings → Environment Variables).
# Find them in Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both empty for the local demo: `npm run dev` gives a working admin that saves to .demo/.
# A deployed site without them shows the sample projects read-only, with no admin.
